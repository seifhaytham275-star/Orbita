# Supabase project (public client values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for company-username login and platform admin company listing.
# NEVER prefix this with NEXT_PUBLIC_ and NEVER commit the value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC secret for the independent Orbita admin session.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ORBITA_ADMIN_SESSION_SECRET=

# HTTPS deployment URL embedded into the Windows and Android shells.
ORBITA_WEB_URL=https://your-orbita-domain.example

# Optional payment display details only. Payment collection is not activated by these values.
INSTAPAY_RECEIVER_IDENTIFIER=
FAWRY_MERCHANT_CODE=
