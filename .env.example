# Supabase public project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Payment display configuration. Keep actual payment identifiers in deployment secrets,
# not in source code or this public repository.
INSTAPAY_RECEIVER_IDENTIFIER=
FAWRY_MERCHANT_CODE=
FAWRY_SECRET_KEY=

# Owner bootstrap email (server-side only)
OWNER_EMAIL=

# AI provider adapter; add provider credentials only in local/deployment environment.
AI_PROVIDER=
AI_API_KEY=
